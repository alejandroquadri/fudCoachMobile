{
  "name": "fudcoachmobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "env npm_config_cache=.expo/npm-cache __UNSAFE_EXPO_HOME_DIRECTORY=.expo/home CP_HOME_DIR=.expo/cocoapods expo prebuild",
    "prebuild:ios:clean": "env npm_config_cache=.expo/npm-cache __UNSAFE_EXPO_HOME_DIRECTORY=.expo/home CP_HOME_DIR=.expo/cocoapods expo prebuild --clean --platform ios",
    "pods": "env CP_HOME_DIR=.expo/cocoapods pod install --project-directory=ios --repo-update",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern ios --ignore-pattern android",
    "doctor": "env npm_config_cache=.expo/npm-cache __UNSAFE_EXPO_HOME_DIRECTORY=.expo/home npx expo-doctor@latest",
    "fix:pods": "yarn pods"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "4.5.6",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/drawer": "^6.6.3",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/native-stack": "^6.9.13",
    "@rneui/base": "4.0.0-rc.8",
    "@rneui/themed": "4.0.0-rc.8",
    "axios": "^1.5.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~53.0.27",
    "expo-apple-authentication": "~7.2.4",
    "expo-application": "~6.1.5",
    "expo-camera": "~16.1.11",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-iap": "5.6.2",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-notifications": "~0.31.5",
    "expo-secure-store": "~14.2.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.3.28",
    "react-native-gifted-chat": "3.4.0",
    "react-native-keyboard-controller": "^1.16.8",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.20.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.26.9",
    "@types/react": "~19.0.10",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.0.0",
    "prettier": "^3.0.2",
    "typescript": "~5.8.3"
  },
  "private": true
}
