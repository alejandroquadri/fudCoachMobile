{
  "name": "fudcoachmobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "env npm_config_cache=.expo/npm-cache __UNSAFE_EXPO_HOME_DIRECTORY=.expo/home CP_HOME_DIR=.expo/cocoapods expo prebuild",
    "prebuild:ios:clean": "env npm_config_cache=.expo/npm-cache __UNSAFE_EXPO_HOME_DIRECTORY=.expo/home CP_HOME_DIR=.expo/cocoapods expo prebuild --clean --platform ios",
    "pods": "env CP_HOME_DIR=.expo/cocoapods pod install --project-directory=ios --repo-update",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern ios --ignore-pattern android",
    "doctor": "env npm_config_cache=.expo/npm-cache __UNSAFE_EXPO_HOME_DIRECTORY=.expo/home npx expo-doctor@latest",
    "fix:pods": "yarn pods"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-community/slider",
        "react-native-reanimated"
      ]
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "4.5.6",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/drawer": "7.14.2",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.2",
    "@rneui/base": "4.0.0-rc.8",
    "@rneui/themed": "4.0.0-rc.8",
    "axios": "^1.5.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "^3.2.0",
    "expo": "^54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-camera": "~17.0.10",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-iap": "5.6.2",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "1.4.78",
    "react-native-gifted-chat": "3.4.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.26.9",
    "@types/react": "~19.1.10",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.0.0",
    "prettier": "^3.0.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
