{
  "name": "fudcoachmobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "env npm_config_cache=.expo/npm-cache __UNSAFE_EXPO_HOME_DIRECTORY=.expo/home CP_HOME_DIR=.expo/cocoapods expo prebuild",
    "prebuild:ios:clean": "env npm_config_cache=.expo/npm-cache __UNSAFE_EXPO_HOME_DIRECTORY=.expo/home CP_HOME_DIR=.expo/cocoapods expo prebuild --clean --platform ios",
    "pods": "env CP_HOME_DIR=.expo/cocoapods pod install --project-directory=ios --repo-update",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern ios --ignore-pattern android",
    "doctor": "env npm_config_cache=.expo/npm-cache __UNSAFE_EXPO_HOME_DIRECTORY=.expo/home npx expo-doctor@latest",
    "fix:pods": "yarn pods"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-native-vector-icons/feather": "13.1.4",
    "@react-native-vector-icons/ionicons": "13.1.4",
    "@react-native-vector-icons/material-design-icons": "13.1.4",
    "@react-native-vector-icons/material-icons": "13.1.4",
    "@react-navigation/drawer": "7.14.2",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.2",
    "@rneui/base": "5.0.0",
    "@rneui/themed": "5.0.0",
    "axios": "^1.5.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "^3.2.0",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-iap": "5.6.2",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "1.4.78",
    "react-native-gifted-chat": "3.4.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.26.9",
    "@types/react": "~19.2.10",
    "@types/react-native-vector-icons": "6.4.18",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.0.0",
    "prettier": "^3.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
